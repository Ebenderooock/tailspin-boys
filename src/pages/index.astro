---
/*
 * Home page for the Tailspin Toys catalog.
 *
 * Renders the prerendered game listing and browser-side category/publisher
 * filters using build-time data from the local SQLite database.
 */
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import Card from '../components/Card.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <Card as="section" class="mb-8 p-6" aria-labelledby="filters-heading" data-testid="game-filters">
            <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
              <div>
                <h3 id="filters-heading" class="text-xl font-semibold text-slate-100">Filter games</h3>
                <p class="mt-1 text-sm text-slate-300">Choose categories and publishers to narrow the catalog.</p>
              </div>
              <button
                type="button"
                class="inline-flex items-center justify-center rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-100 transition-colors duration-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-filters-button"
              >
                Clear filters
              </button>
            </div>

            <form class="mt-6 grid gap-6 lg:grid-cols-2" data-testid="filters-form">
              <fieldset class="rounded-lg border border-slate-700 p-4" data-testid="category-filter-group">
                <legend class="px-1 text-sm font-semibold text-slate-100">Categories</legend>
                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                  {categories.map((category) => (
                    <label class="flex items-center gap-3 rounded-lg px-2 py-1 text-sm text-slate-200 hover:bg-slate-700/60">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-600 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`category-filter-${category.id}`}
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <fieldset class="rounded-lg border border-slate-700 p-4" data-testid="publisher-filter-group">
                <legend class="px-1 text-sm font-semibold text-slate-100">Publishers</legend>
                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                  {publishers.map((publisher) => (
                    <label class="flex items-center gap-3 rounded-lg px-2 py-1 text-sm text-slate-200 hover:bg-slate-700/60">
                      <input
                        type="checkbox"
                        name="publisher"
                        value={publisher.id}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-600 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`publisher-filter-${publisher.id}`}
                      />
                      <span>{publisher.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </form>

            <p class="mt-5 text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-results-status">
              Showing {games.length} {games.length === 1 ? 'game' : 'games'}
            </p>
          </Card>

          <div class="hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="category"]'));
  const publisherInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="publisher"]'));
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters-button"]');
  const status = document.querySelector<HTMLElement>('[data-testid="filter-results-status"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  let unmatchedCategoryIds: string[] = [];
  let unmatchedPublisherIds: string[] = [];

  function selectedValues(inputs: HTMLInputElement[], unmatchedValues: string[]): string[] {
    return [...inputs.filter((input) => input.checked).map((input) => input.value), ...unmatchedValues];
  }

  function setQueryParameters(categoryIds: string[], publisherIds: string[]): void {
    const url = new URL(window.location.href);
    url.searchParams.delete('category');
    url.searchParams.delete('publisher');

    for (const categoryId of categoryIds) {
      url.searchParams.append('category', categoryId);
    }

    for (const publisherId of publisherIds) {
      url.searchParams.append('publisher', publisherId);
    }

    window.history.replaceState({}, '', url);
  }

  function restoreInputsFromQuery(): void {
    const params = new URLSearchParams(window.location.search);
    const categoryIds = new Set(params.getAll('category'));
    const publisherIds = new Set(params.getAll('publisher'));

    for (const input of categoryInputs) {
      input.checked = categoryIds.has(input.value);
      categoryIds.delete(input.value);
    }

    for (const input of publisherInputs) {
      input.checked = publisherIds.has(input.value);
      publisherIds.delete(input.value);
    }

    unmatchedCategoryIds = [...categoryIds];
    unmatchedPublisherIds = [...publisherIds];
  }

  function applyFilters(): void {
    const categoryIds = selectedValues(categoryInputs, unmatchedCategoryIds);
    const publisherIds = selectedValues(publisherInputs, unmatchedPublisherIds);
    let visibleCount = 0;

    for (const card of gameCards) {
      const matchesCategory =
        categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '');
      const matchesPublisher =
        publisherIds.length === 0 || publisherIds.includes(card.dataset.publisherId ?? '');
      const isVisible = matchesCategory && matchesPublisher;

      card.classList.toggle('hidden', !isVisible);

      if (isVisible) {
        visibleCount += 1;
      }
    }

    if (status) {
      status.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    }

    emptyState?.classList.toggle('hidden', visibleCount !== 0);
    gamesGrid?.classList.toggle('hidden', visibleCount === 0);
    setQueryParameters(categoryIds, publisherIds);
  }

  function clearFilters(): void {
    unmatchedCategoryIds = [];
    unmatchedPublisherIds = [];

    for (const input of [...categoryInputs, ...publisherInputs]) {
      input.checked = false;
    }

    applyFilters();
  }

  for (const input of [...categoryInputs, ...publisherInputs]) {
    input.addEventListener('change', () => {
      unmatchedCategoryIds = [];
      unmatchedPublisherIds = [];
      applyFilters();
    });
  }

  clearButton?.addEventListener('click', clearFilters);
  restoreInputsFromQuery();
  applyFilters();
</script>
