---
/*
 * Page hero component for prominent page headings.
 *
 * Renders the page-level heading and optional introductory copy.
 */
interface Props {
    /** Main heading text for the page. */
    title: string;
    /** Optional supporting text rendered below the heading. */
    subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="max-w-3xl mb-10" data-testid="page-hero">
    <h1 class="text-4xl font-bold mb-4 text-slate-100 high-contrast:!text-white" data-testid="page-hero-title">{title}</h1>
    {subtitle && (
        <p class="text-xl text-slate-300 high-contrast:!text-white" data-testid="page-hero-subtitle">{subtitle}</p>
    )}
    <slot />
</div>
